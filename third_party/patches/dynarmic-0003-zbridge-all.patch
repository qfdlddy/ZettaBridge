+// Computes stripe = StripeIndex(u64(u32(Waddr))) into Xscratch0. Clobbers Xscratch1.
+void EmitComputeStripeIndex(oaknut::CodeGenerator& code, oaknut::WReg Waddr) {
+    code.MOV(Wscratch0, Waddr);
+    code.LSR(Xscratch0, Xscratch0, 2);
+    code.MOV(Xscratch1, 0x9e3779b97f4a7c15ull);
+    code.MUL(Xscratch0, Xscratch0, Xscratch1);
+    code.LSR(Xscratch0, Xscratch0, 58);
+}
+
+// Sets Xscratch0 = &stripe_active[stripe * words_per_stripe + word_offset], where
+// stripe = (Xlock - stripes_ptr) >> 6. Clobbers Xscratch1. Xlock must not be Xscratch0/1.
+void EmitStripeActiveWordPtr(oaknut::CodeGenerator& code, const ExclusiveMonitor::InlineArm64Layout& mon,
+                             oaknut::XReg Xlock, size_t word_offset) {
+    static_assert(ExclusiveMonitor::StripeByteStride() == 64);
+    code.MOV(Xscratch1, mon.stripes_ptr);
+    code.SUB(Xscratch0, Xlock, Xscratch1);
+    code.LSR(Xscratch0, Xscratch0, 6);
+    if (mon.words_per_stripe != 1) {
+        code.MOV(Xscratch1, mon.words_per_stripe);
+        code.MUL(Xscratch0, Xscratch0, Xscratch1);
+    }
+    if (word_offset != 0) {
+        if (word_offset <= 0xfff) {
+            code.ADD(Xscratch0, Xscratch0, word_offset);
+        } else {
+            code.MOV(Xscratch1, word_offset);
+            code.ADD(Xscratch0, Xscratch0, Xscratch1);
+        }
+    }
+    code.LSL(Xscratch0, Xscratch0, 3);
+    code.MOV(Xscratch1, mon.stripe_active_ptr);
+    code.ADD(Xscratch0, Xscratch1, Xscratch0);
+}
+
+// Clears this processor's reservation inside its stripe lock (matching CheckAndClear when value fails).
+// Clobbers Xscratch0, Xscratch1, Xscratch2.
+void EmitClearSelfMonitorState(oaknut::CodeGenerator& code, EmitContext& ctx,
+                               const ExclusiveMonitor::InlineArm64Layout& mon) {
+    const size_t proc_word = mon.processor_id >> 6;
+    const u64 proc_bit_mask = u64{1} << (mon.processor_id & 63);
+
+    code.MOV(Xscratch0, mon.excl_addr_proc_ptr);
+    code.MOV(Xscratch1, ExclusiveMonitor::InvalidExclusiveAddress());
+    code.STR(Xscratch1, Xscratch0);
+
+    code.LDR(Xscratch2, Xstate, ctx.conf.state_exclusive_lock_ptr_offset);
+    EmitStripeActiveWordPtr(code, mon, Xscratch2, proc_word);
+    code.LDR(Xscratch1, Xscratch0);
+    code.MOV(Xscratch2, ~proc_bit_mask);
+    code.AND(Xscratch1, Xscratch1, Xscratch2);
+    code.STR(Xscratch1, Xscratch0);
+
+    code.MOV(Xscratch0, mon.proc_stripe_ptr);
+    code.MOV(Xscratch1, ExclusiveMonitor::InvalidStripe());
+    code.STR(Xscratch1, Xscratch0);
+}
