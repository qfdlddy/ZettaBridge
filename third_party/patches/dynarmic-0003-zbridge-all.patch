+        code.LDR(Xscratch1, Xscratch0);
+    } else {
+        code.LDR(Wscratch1, Xscratch0);
+        if constexpr (bitsize == 8) {
+            code.AND(Wscratch1, Wscratch1, 0xffu);
+        } else if constexpr (bitsize == 16) {
+            code.AND(Wscratch1, Wscratch1, 0xffffu);
+        }
