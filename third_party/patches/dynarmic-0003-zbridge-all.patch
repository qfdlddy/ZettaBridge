+template<size_t bitsize>
+void FastmemEmitExclusiveReadMemory(oaknut::CodeGenerator& code, EmitContext& ctx, IR::Inst* inst, DoNotFastmemMarker marker) {
+    static_assert(bitsize == 8 || bitsize == 16 || bitsize == 32 || bitsize == 64);
+    static_assert(ExclusiveMonitor::StripeByteStride() == 64);
+    const auto& mon = *ctx.conf.exclusive_monitor;
+    const size_t proc_word = mon.processor_id >> 6;
+    const u64 proc_bit_mask = u64{1} << (mon.processor_id & 63);
+
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    auto Xaddr = ctx.reg_alloc.ReadX(args[1]);
+    auto Rvalue = ctx.reg_alloc.WriteReg<std::max<std::size_t>(bitsize, 32)>(inst);
+    const bool ordered = IsOrdered(args[2].GetImmediateAccType());
+    ctx.reg_alloc.SpillFlags();
+    RegAlloc::Realize(Xaddr, Rvalue);
+
+    oaknut::Label l_same_or_invalid;
+    SharedLabel fallback_locked = GenSharedLabel(), fallback = GenSharedLabel(), end = GenSharedLabel();
+
+    if constexpr (bitsize >= 16) {
+        code.TST(Xaddr->toW(), (bitsize / 8) - 1);
+        code.B(NE, *fallback);
+    }
+
+    // Fast path only when processor currently holds no stripe lock or holds the same stripe.
+    // Cross-stripe nested LDREX falls back to C++ LockForRead (canonical lock order).
+    EmitComputeStripeIndex(code, Xaddr->toW());  // Xscratch0 = new_stripe
+    code.MOV(Xscratch1, mon.proc_stripe_ptr);
+    code.LDR(Xscratch1, Xscratch1);
+    code.MOV(Xscratch2, ExclusiveMonitor::InvalidStripe());
+    code.CMP(Xscratch1, Xscratch2);
+    code.B(EQ, l_same_or_invalid);
+    code.CMP(Xscratch1, Xscratch0);
+    code.B(NE, *fallback);
+    code.l(l_same_or_invalid);
+
+    code.LSL(Xscratch0, Xscratch0, 6);
+    code.MOV(Xscratch1, mon.stripes_ptr);
+    code.ADD(Xscratch2, Xscratch1, Xscratch0);  // Xscratch2 = &stripes[new_stripe].lock
+    EmitSpinLockLock(code, Xscratch2);
+
+    // Load into Xscratch1 first so Xaddr is untouched on SIGSEGV or Rvalue == Xaddr aliasing.
+    const auto [Xbase, Xoffset] = FastmemEmitVAddrLookup<bitsize>(code, ctx, *Xaddr, fallback_locked);
+    const auto fastmem_location = EmitMemoryLdr<bitsize>(code, Xscratch1.index(), Xbase, Xoffset, true, ShouldExt32(ctx));
+
+    code.MOV(Wscratch0, Xaddr->toW());
+    code.MOV(Rvalue->toX(), Xscratch1);
+
+    code.MOV(Xscratch1, mon.excl_addr_proc_ptr);
+    code.STR(Xscratch0, Xscratch1);
+    code.MOV(Xscratch1, mon.excl_val_proc_ptr);
+    code.STR(Rvalue->toX(), Xscratch1);
+
+    code.MOV(Wscratch0, 1);
+    code.STRB(Wscratch0, Xstate, ctx.conf.state_exclusive_state_offset);
+
+    code.MOV(Xscratch0, mon.stripes_ptr);
+    code.SUB(Xscratch0, Xscratch2, Xscratch0);
+    code.LSR(Xscratch0, Xscratch0, 6);  // new_stripe
+    code.MOV(Xscratch1, mon.proc_stripe_ptr);
+    code.STR(Xscratch0, Xscratch1);
+
+    if (mon.words_per_stripe != 1) {
+        code.MOV(Xscratch1, mon.words_per_stripe);
+        code.MUL(Xscratch0, Xscratch0, Xscratch1);
+    }
+    if (proc_word != 0) {
+        if (proc_word <= 0xfff) {
+            code.ADD(Xscratch0, Xscratch0, proc_word);
+        } else {
+            code.MOV(Xscratch1, proc_word);
+            code.ADD(Xscratch0, Xscratch0, Xscratch1);
+        }
+    }
+    code.LSL(Xscratch0, Xscratch0, 3);
+    code.MOV(Xscratch1, mon.stripe_active_ptr);
+    code.ADD(Xscratch0, Xscratch1, Xscratch0);
+    code.LDR(Xscratch1, Xscratch0);
+    code.ORR(Xscratch1, Xscratch1, proc_bit_mask);
+    code.STR(Xscratch1, Xscratch0);
+
+    EmitSpinLockUnlock(code, Xscratch2);
+
+    ctx.deferred_emits.emplace_back([&code, &ctx, inst, marker, Xaddr = *Xaddr, Rvalue = *Rvalue, ordered, fallback_locked, fallback, end, fastmem_location] {
+        code.l(*fallback_locked);
+        const u64 locked_call_pc = mcl::bit_cast<u64>(code.xptr<void*>());
+        EmitSpinLockUnlock(code, Xscratch2);
+
+        ctx.ebi.fastmem_patch_info.emplace(
+            fastmem_location - ctx.ebi.entry_point,
+            FastmemPatchInfo{
+                .marker = marker,
+                .fc = FakeCall{
+                    .call_pc = locked_call_pc,
+                },
+                .recompile = ctx.conf.recompile_on_exclusive_fastmem_failure,
+            });
+
+        code.l(*fallback);
+        code.MOV(Xscratch0, Xaddr);
+        EmitRelocation(code, ctx, WrappedExclusiveReadMemoryLinkTarget(bitsize));
+        if (ordered) {
+            code.DMB(oaknut::BarrierOp::ISH);
+        }
+        code.MOV(Wscratch1, 1);
+        code.STRB(Wscratch1, Xstate, ctx.conf.state_exclusive_state_offset);
+        code.MOV(Rvalue.toX(), Xscratch0);
+        ctx.conf.emit_check_memory_abort(code, ctx, inst, *end);
+        code.B(*end);
+    });
+
+    code.l(*end);
+}
+
+template<size_t bitsize>
+void FastmemEmitExclusiveWriteMemory(oaknut::CodeGenerator& code, EmitContext& ctx, IR::Inst* inst, DoNotFastmemMarker marker) {
+    static_assert(bitsize == 8 || bitsize == 16 || bitsize == 32 || bitsize == 64);
+    static_assert(ExclusiveMonitor::StripeByteStride() == 64);
+    const auto& mon = *ctx.conf.exclusive_monitor;
+    const size_t proc_word = mon.processor_id >> 6;
+    const u64 proc_bit_mask = u64{1} << (mon.processor_id & 63);
+
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    auto Xaddr = ctx.reg_alloc.ReadX(args[1]);
+    auto Rvalue = ctx.reg_alloc.ReadReg<std::max<std::size_t>(bitsize, 32)>(args[2]);
+    auto Wresult = ctx.reg_alloc.WriteW(inst);
+    const bool ordered = IsOrdered(args[3].GetImmediateAccType());
+    ctx.reg_alloc.SpillFlags();
+    RegAlloc::Realize(Xaddr, Rvalue, Wresult);
+
+    oaknut::Label l_fail_cas_unlock, l_fail_unlock, l_fail_no_unlock, l_cas_loop;
+    SharedLabel fallback_locked = GenSharedLabel(), fallback = GenSharedLabel(), end = GenSharedLabel();
+
+    code.LDRB(Wscratch0, Xstate, ctx.conf.state_exclusive_state_offset);
+    code.CBZ(Wscratch0, l_fail_no_unlock);
+
+    if constexpr (bitsize >= 16) {
+        code.TST(Xaddr->toW(), (bitsize / 8) - 1);
+        code.B(NE, *fallback);
+    }
+
+    EmitComputeStripeIndex(code, Xaddr->toW());  // Xscratch0 = stripe
+    code.MOV(Xscratch1, mon.proc_stripe_ptr);
+    code.LDR(Xscratch1, Xscratch1);
+    code.CMP(Xscratch1, Xscratch0);
+    code.B(NE, l_fail_no_unlock);
+
+    code.LSL(Xscratch0, Xscratch0, 6);
+    code.MOV(Xscratch1, mon.stripes_ptr);
+    code.ADD(Xscratch2, Xscratch1, Xscratch0);  // Xscratch2 = &stripes[stripe].lock
+    EmitSpinLockLock(code, Xscratch2);
+
+    // Check exclusive_addresses[proc] == masked_vaddr while holding stripe lock (prevents ABA).
+    code.MOV(Wscratch0, Xaddr->toW());
+    code.MOV(Xscratch1, mon.excl_addr_proc_ptr);
+    code.LDR(Xscratch1, Xscratch1);
+    code.CMP(Xscratch1, Xscratch0);
+    code.B(NE, l_fail_unlock);
+
+    code.STR(Xscratch2, Xstate, ctx.conf.state_exclusive_lock_ptr_offset);
