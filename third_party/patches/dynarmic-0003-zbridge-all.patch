+    case 16:
+        code.LDAXRH(Wscratch2, Xscratch0);
+        code.CMP(Wscratch2, Wscratch1);
+        break;
+    case 32:
+        code.LDAXR(Wscratch2, Xscratch0);
+        code.CMP(Wscratch2, Wscratch1);
+        break;
+    case 64:
+        code.LDAXR(Xscratch2, Xscratch0);
+        code.CMP(Xscratch2, Xscratch1);
